{% if include.id %}
  {% assign gallery = page[include.id] %}
{% else %}
  {% assign gallery = page.gallery %}
{% endif %}

<figure class="gallery gallery--{{ include.layout | default: 'grid' }}{% if include.class %} {{ include.class }}{% endif %}">
  {% for img in gallery %}
    {% if img.url %}
      <a class="gallery__item" href="{{ img.url | relative_url }}" data-lightbox-group="gallery"{% if img.title %} data-caption="{{ img.title | escape }}"{% endif %}>
        <img src="{{ img.image_path | relative_url }}" alt="{{ img.alt | default: img.title | escape }}" loading="lazy">
        {% if img.title %}<span class="gallery__caption">{{ img.title }}</span>{% endif %}
      </a>
    {% else %}
      <span class="gallery__item">
        <img src="{{ img.image_path | relative_url }}" alt="{{ img.alt | default: img.title | escape }}" loading="lazy">
      </span>
    {% endif %}
  {% endfor %}
  {% if include.caption %}
    <figcaption>{{ include.caption | markdownify | remove: "<p>" | remove: "</p>" }}</figcaption>
  {% endif %}
</figure>
