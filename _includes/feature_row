{% if include.id %}
  {% assign feature_row = page[include.id] %}
{% else %}
  {% assign feature_row = page.feature_row %}
{% endif %}

<div class="feature-row">
  {% for f in feature_row %}
    <div class="card feature">
      {% if f.image_path %}
        <div class="feature__media">
          <img src="{{ f.image_path | relative_url }}" alt="{{ f.alt | escape }}" loading="lazy">
        </div>
      {% endif %}
      <div class="feature__body">
        {% if f.title %}<h3>{{ f.title }}</h3>{% endif %}
        {% if f.excerpt %}{{ f.excerpt | markdownify }}{% endif %}
        {% if f.url %}<p><a class="btn" href="{{ f.url | relative_url }}">{{ f.btn_label | default: 'Learn more' }}</a></p>{% endif %}
      </div>
    </div>
  {% endfor %}
</div>
